      "Bash(perl -0777 -pi -e 's/\\\\t\\\\tlogWarnf\\\\\\(\"netstack: TCP connect to %s failed: %v\", target, err\\\\\\)\\\\n\\\\t\\\\tr\\\\.Complete\\\\\\(true\\\\\\)/\\\\t\\\\tlogWarnf\\(\"netstack: TCP connect to %s failed: %v\", target, err\\)\\\\n\\\\t\\\\tr.Complete\\(false\\) \\\\/\\\\/ mutant/' agent/netstack.go)",
      "Bash(perl -0777 -pi -e 's/\\\\t\\\\terr := p\\\\.out\\\\.WriteMessage\\\\\\(websocket\\\\.BinaryMessage, data\\\\\\)/\\\\t\\\\terr := func\\(\\) error { _ = data; return nil }\\(\\) \\\\/\\\\/ mutant: drop outbound/' agent/netstack.go)",
      "Bash(perl -0777 -pi -e 's/\\\\t\\\\terr := p\\\\.out\\\\.WriteMessage\\\\\\(websocket\\\\.BinaryMessage, data\\\\\\)/\\\\t\\\\tvar err error\\\\n\\\\t\\\\tif false { err = p.out.WriteMessage\\(websocket.BinaryMessage, data\\) } \\\\/\\\\/ mutant/' agent/netstack.go)",
      "Bash(perl -0777 -pi -e 's/- \\\\[ \\\\] \\\\*\\\\*Migrate the tunnel \\\\*receive\\\\* path to gVisor netstack\\\\.\\\\*\\\\* Deletes the/- [x] **Tunnel receive path now runs on gVisor netstack.** Deletes the/' ROADMAP.md)",
      "Bash(perl -0777 -pi -e 's/ Ship behind `JETTY_TUNNEL_STACK=netstack\\\\|legacy` so there is an instant\\\\n rollback that does not need a different binary\\\\./ Shipped behind `JETTY_TUNNEL_STACK`, defaulting to `netstack`; set it to\\\\n `legacy` to roll back without a different binary. Tested by joining two\\\\n netstacks over an in-memory wire, so a real handshake and an 8MB\\\\n transfer run through the actual receive path \\(~0.12s\\). Binary 29M -> 33M.\\\\n\\\\n NOT yet verified against real hardware, real workloads, or a real\\\\n WebSocket - see \"Verify under load\" above, which is still the gate./' ROADMAP.md)",
      "Bash(awk '/^## /{sec=$0} /^- \\\\[ \\\\]/{gsub\\(/^- \\\\[ \\\\] /,\"\"\\); print sec\" ||| \"$0}' ROADMAP.md)",
      "Bash(perl -0777 -pi -e 's/\\\\/\\\\/ Caller must hold a\\\\.stateMu \\\\\\(read or write\\\\\\)\\\\. Internally takes\\\\n\\\\/\\\\/ a\\\\.workloadRoutesMu for the route-table mutation\\\\.\\\\nfunc \\\\\\(a \\\\*Agent\\\\\\) updateWorkloadRoutes\\\\\\(\\\\\\) \\\\{.*?\\\\n\\\\}\\\\n//s' agent/routes.go)",
      "Bash(perl -pi -e 's/\\\\ba\\\\.updateWorkloadRoutes\\\\\\(\\\\\\)/a.triggerRouteReconcile\\(\\)/g' agent/*.go)",
      "Bash(perl -0777 -pi -e 's/\\(\\\\tworkloadRoutesMu\\\\s+sync\\\\.Mutex\\\\n\\)/$1\\\\t\\\\/\\\\/ routeReconcileCh is a capacity-1 level trigger for route reconciliation.\\\\n\\\\t\\\\/\\\\/ Capacity 1 so triggerRouteReconcile never blocks - it is called with\\\\n\\\\t\\\\/\\\\/ stateMu held.\\\\n\\\\trouteReconcileCh chan struct{}\\\\n/' agent/types.go)",
      "Bash(perl -ni -e 'print unless $_ eq \"\\\\t\\\\\"os/exec\\\\\"\\\\n\"' agent/routes.go)",
      "Bash(perl -0777 -pi -e 's/\\(\\\\t\\\\tworkloadRoutes:     make\\\\\\(map\\\\[string\\\\]string\\\\\\),\\\\n\\)/$1\\\\t\\\\trouteReconcileCh:   make\\(chan struct{}, 1\\),\\\\n/' agent/agent.go)",
      "Bash(perl -0777 -pi -e 's/\\(\\\\tgoSupervised\\\\\\(\"reconcileWorkloadsLoop\", a\\\\.reconcileWorkloadsLoop\\\\\\)\\\\n\\)/$1\\\\n\\\\t\\\\/\\\\/ Route programming runs here and nowhere else. Callers only signal, so\\\\n\\\\t\\\\/\\\\/ no fork\\\\/exec ever happens under stateMu - see routereconcile.go.\\\\n\\\\tgoSupervised\\(\"routeReconcileLoop\", a.routeReconcileLoop\\)\\\\n/' agent/agent.go)",
      "Bash(cp agent/routereconcile.go /tmp/rr.bak)",
      "Bash(perl -0777 -pi -e 's/\\\\ta\\\\.workloadRoutesMu\\\\.Lock\\\\\\(\\\\\\)\\\\n\\\\tdefer a\\\\.workloadRoutesMu\\\\.Unlock\\\\\\(\\\\\\)/\\\\ta.stateMu.Lock\\(\\)          \\\\/\\\\/ mutant: the original bug\\\\n\\\\tdefer a.stateMu.Unlock\\(\\)\\\\n\\\\ta.workloadRoutesMu.Lock\\(\\)\\\\n\\\\tdefer a.workloadRoutesMu.Unlock\\(\\)/' agent/routereconcile.go)",
      "Bash(cp /tmp/rr.bak agent/routereconcile.go)",
      "Bash(perl -0777 -pi -e 's/\\\\/\\\\/ routePeer is the subset of a Peer the route path needs\\\\./\\\\/\\\\/ routeCommandRunner is the indirection the route path execs through. A var so\\\\n\\\\/\\\\/ tests can substitute a deliberately slow command and assert that API-path\\\\n\\\\/\\\\/ read locks are still served while it runs - the property that failed in\\\\n\\\\/\\\\/ production, and which a fast-failing command cannot demonstrate.\\\\nvar routeCommandRunner = runBoundedCommand\\\\n\\\\n\\\\/\\\\/ routePeer is the subset of a Peer the route path needs./' agent/routereconcile.go)",
      "Bash(perl -0777 -pi -e 's/runBoundedCommand\\\\\\(routeCommandTimeout,/routeCommandRunner\\(routeCommandTimeout,/g' agent/routereconcile.go)",
      "Bash(perl -0777 -pi -e ' *)",
      "Bash(sed -n '/^func \\(a \\\\*Agent\\) ensurePeerTunnel/,/^}/p' agent/network.go)",
      "Bash(awk '/^## |^### /{sec=$0} /^- \\\\[ \\\\]/{gsub\\(/^- \\\\[ \\\\] /,\"\"\\); print sec\" ||| \"$0}' ROADMAP.md)",
      "Bash(perl -0777 -pi -e 's/import \\\\\\(\\\\n\\\\t\"net\\\\/http\"/import \\(\\\\n\\\\t\"encoding\\\\/json\"\\\\n\\\\t\"net\\\\/http\"/' agent/livez.go)",
      "Bash(perl -0777 -pi -e 's{\\(\\\\tr\\\\.HandleFunc\\\\\\(\"/api/leave\", a\\\\.apiLeave\\\\\\)\\\\.Methods\\\\\\(\"POST\"\\\\\\)\\\\n\\)}{$1\\\\tr.HandleFunc\\(\"/api/livez\", a.apiLivez\\).Methods\\(\"GET\"\\)\\\\n}' agent/api.go)",
      "Bash(cp agent/api.go /tmp/api.bak)",
      "Bash(perl -0777 -pi -e 's/\\(\\\\t\\\\tpublicPaths := \\\\[\\\\]string\\\\{\\\\n\\\\t\\\\t\\\\t\"\\\\/api\\\\/health\",\\\\n\\\\t\\\\t\\\\t\"\\\\/api\\\\/livez\",\\\\n\\\\t\\\\t\\\\t\"\\\\/api\\\\/join\",\\\\n\\\\t\\\\t\\\\t\"\\\\/swagger\\\\/\",\\\\n\\\\t\\\\t\\\\}\\\\n\\)/\\\\t\\\\ta.stateMu.RLock\\(\\) \\\\/\\\\/ mutant: the original ordering\\\\n\\\\t\\\\t_ = a.state.AdminKey\\\\n\\\\t\\\\ta.stateMu.RUnlock\\(\\)\\\\n$1/' agent/api.go)",
      "Bash(cp /tmp/api.bak agent/api.go)",
      "Bash(perl -0777 -pi -e 's/- \\\\[ \\\\] \\\\*\\\\*Watchdog for a wedged control plane\\\\.\\\\*\\\\* The reason the outage cost\\\\n      hours is that `\\\\/api\\\\/health` sits behind the same middleware, so a\\\\n      deadlocked node reports nothing at all rather than reporting that it is\\\\n      deadlocked\\\\. A goroutine that periodically attempts `TryRLock` with a\\\\n      deadline and logs loudly \\\\\\(or exits, letting Docker restart it\\\\\\) turns an\\\\n      invisible hang into a visible one\\\\. Worth having independent of any\\\\n      specific deadlock\\\\./- [x] **A wedged control plane can now say so.** Two subtractions rather than\\\\n      new machinery, which is why there is no watchdog goroutine:\\\\n\\\\n      1. `apiKeyMiddleware` took `stateMu.RLock\\(\\)` and scanned the whole peer\\\\n         table *before* checking whether the path needed auth at all - so\\\\n         `\\\\/api\\\\/health` depended on a lock it had no reason to touch, and\\\\n         discarded the result. The public-path check now comes first. Strictly\\\\n         less work per request.\\\\n      2. `GET \\\\/api\\\\/livez` reports liveness, uptime, goroutine count and\\\\n         whether `stateMu` is acquirable \\(`TryRLock`, non-blocking\\) - so it\\\\n         cannot get stuck on the lock it is reporting on. No background\\\\n         goroutine, no polling, no timer: it costs nothing until called.\\\\n\\\\n      `\\\\/api\\\\/health` is not a liveness check - it takes `stateMu` twice. Use\\\\n      `\\\\/api\\\\/livez` when a node is unresponsive; `state_lock_acquirable=false`\\\\n      alongside a high goroutine count means wedged rather than busy, and it\\\\n      says so in a `diagnosis` field./' ROADMAP.md)",
      "Bash(grep -oE 'logInfof\\\\\\(\"[^\"]{0,70}')",
      "Bash(perl -pi -e 's/logInfof\\\\\\(\"!!!/logWarnf\\(\"!!!/g' agent/agent.go)",
      "Bash(perl -0777 -pi -e 's/\\\\t\"strings\"\\\\n\\\\t\"time\"\\\\n\\\\\\)/\\\\t\"strings\"\\\\n\\\\t\"sync\"\\\\n\\\\t\"time\"\\\\n\\)/' agent/log.go)",
      "Bash(perl -0777 -pi -e 's{// parseLogLevel maps a name to a level, defaulting to info\\\\. An unrecognised\\\\n// value falls back rather than failing startup - a typo in an env var should\\\\n// not stop a node from booting\\\\.\\\\n// normalizeLogLevel canonicalises a level name\\\\. Shared so the parser and the\\\\n// API validator cannot disagree about what is valid\\\\.\\\\nfunc normalizeLogLevel}{// normalizeLogLevel canonicalises a level name. Shared so the parser and the\\\\n// API validator cannot disagree about what is valid.\\\\nfunc normalizeLogLevel}' agent/log.go)",
      "Bash(perl -0777 -pi -e 's{\\\\nfunc parseLogLevel\\\\\\(name string\\\\\\) slog\\\\.Level \\\\{}{\\\\n// parseLogLevel maps a name to a level, defaulting to info. An unrecognised\\\\n// value falls back rather than failing startup - a typo in an env var should\\\\n// not stop a node from booting. The API validator rejects instead; see\\\\n// isKnownLogLevel.\\\\nfunc parseLogLevel\\(name string\\) slog.Level {}' agent/log.go)",
      "Bash(cp agent/log.go /tmp/log.bak)",
      "Bash(perl -0777 -pi -e 's/func SetLogLevel\\\\\\(name string\\\\\\) slog\\\\.Level \\\\{\\\\n\\\\tlogMu\\\\.Lock\\\\\\(\\\\\\)\\\\n\\\\tdefer logMu\\\\.Unlock\\\\\\(\\\\\\)\\\\n\\\\treturn initLogging\\\\\\(name, logFormat, logOutput\\\\\\)\\\\n\\\\}/func SetLogLevel\\(name string\\) slog.Level {\\\\n\\\\tlvl := parseLogLevel\\(name\\) \\\\/\\\\/ mutant: level only, no rebuild\\\\n\\\\tlevelVar.Set\\(lvl\\)\\\\n\\\\treturn lvl\\\\n}/' agent/log.go)",
      "Bash(cp /tmp/log.bak agent/log.go)",
      "Bash(perl -0777 -pi -e 's{\\\\| `JETTY_LOG_LEVEL` \\\\| `debug`, `info`, `warn`, or `error`\\\\. `debug` also turns on source file:line\\\\. An unrecognised value falls back to `info` rather than failing startup\\\\. \\\\| `info` \\\\|}{| `JETTY_LOG_LEVEL` | Startup log level: `debug`, `info`, `warn`, or `error`. `debug` also turns on source file:line. An unrecognised value falls back to `info` rather than failing startup. Change it on a **running** node with `POST /api/log-level` — restarting to enable debug destroys the state you wanted to debug. | `info` |}' README.md)",
      "Bash(cp agent/routes.go /tmp/rt.bak)",
      "Bash(perl -0777 -pi -e 's/\\\\tsort\\\\.Slice\\\\\\(peers, func\\\\\\(i, j int\\\\\\) bool \\\\{ return peers\\\\[i\\\\]\\\\.name < peers\\\\[j\\\\]\\\\.name \\\\}\\\\\\)\\\\n//; s/\\\\tsort\\\\.Slice\\\\\\(workloads, func\\\\\\(i, j int\\\\\\) bool \\\\{ return workloads\\\\[i\\\\]\\\\.name < workloads\\\\[j\\\\]\\\\.name \\\\}\\\\\\)\\\\n//; s/\\\\t\"sort\"\\\\n//' agent/routes.go)",
      "Bash(cp /tmp/rt.bak agent/routes.go)",
      "Bash(perl -0777 -pi -e 's/- \\\\[ \\\\] \\\\*\\\\*Watchdog for a wedged control plane[\\\\s\\\\S]*?specific deadlock\\\\.\\\\n\\\\n//' ROADMAP.md)",
      "Bash(perl -0777 -pi -e 's{\\(- \\\\[ \\\\] \\\\*\\\\*Audit the remaining ~100 unbounded `exec\\\\.Command` sites\\\\.\\)}{- [x] **`updateHosts` no longer holds a lock across file I/O.** Same shape as\\\\n the route deadlock, one hop further round: it held `stateMu.RLock\\(\\)`\\\\n across `os.ReadFile`/`os.WriteFile` from 16 call sites. A read lock does\\\\n not block readers directly, but a writer queuing behind it does, and\\\\n Go'\"'\"'s RWMutex then excludes every subsequent reader. Now snapshots, then\\\\n does the I/O with nothing held.\\\\n\\\\n Fixing it exposed a live bug: the block was built by ranging over maps,\\\\n and Go randomises map iteration order — so the rendered block differed\\\\n on every call, its hash never matched, and the \"skip the write if\\\\n nothing changed\" optimisation **never fired**. `/etc/hosts` was being\\\\n rewritten on every gossip tick. Entries are now emitted in a stable\\\\n order and the optimisation actually works.\\\\n\\\\n$1}' ROADMAP.md)"
    ]
  }
}
