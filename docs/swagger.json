{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "P2P Docker Compose orchestration with Cloudflare WARP mesh networking",
        "title": "Jetty API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Jetty Support",
            "url": "https://github.com/ncwardell/jetty"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "2.0"
    },
    "host": "localhost:6880",
    "basePath": "/api",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns health status of this node",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cluster"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/agent.HealthResponse"
                        }
                    }
                }
            }
        },
        "/join": {
            "post": {
                "description": "Allows a new node to join the cluster using the cluster secret",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cluster"
                ],
                "summary": "Join cluster",
                "parameters": [
                    {
                        "description": "Join request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/agent.JoinRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/agent.JoinResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid secret",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Mesh IP collision",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/nodes": {
            "get": {
                "description": "Returns all nodes in the cluster (self + peers)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "nodes"
                ],
                "summary": "List all nodes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/agent.Peer"
                            }
                        }
                    }
                }
            }
        },
        "/nodes/{id}": {
            "delete": {
                "description": "Removes a peer node from the cluster. Workloads owned by that node will be orphaned and eligible for failover if revive is enabled.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "nodes"
                ],
                "summary": "Remove a node from the cluster",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Node ID (HWID) or name",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Cannot remove self",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Node not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "description": "Returns full cluster status including node info, peers, workloads, and connectivity status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cluster"
                ],
                "summary": "Get cluster status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/agent.StatusResponse"
                        }
                    }
                }
            }
        },
        "/tunnel": {
            "get": {
                "description": "Returns Cloudflare tunnel configuration status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tunnel"
                ],
                "summary": "Get tunnel status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/agent.TunnelStatus"
                        }
                    }
                }
            },
            "post": {
                "description": "Sets the Cloudflare tunnel token (propagates to all nodes)",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "tunnel"
                ],
                "summary": "Configure tunnel",
                "parameters": [
                    {
                        "description": "Tunnel token",
                        "name": "token",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/agent.TunnelRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Tunnel configured"
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Removes the Cloudflare tunnel configuration",
                "tags": [
                    "tunnel"
                ],
                "summary": "Remove tunnel",
                "responses": {
                    "204": {
                        "description": "Tunnel removed"
                    }
                }
            }
        },
        "/workloads": {
            "get": {
                "description": "Returns all workloads in the cluster, optionally filtered by node",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "List all workloads",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by node name or ID (use 'local' for this node only)",
                        "name": "node",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/agent.Workload"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Creates and deploys a new Docker Compose workload with a mesh IP",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "Deploy a new workload",
                "parameters": [
                    {
                        "description": "Workload configuration",
                        "name": "workload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/agent.WorkloadRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/agent.Workload"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Mesh IP already in use",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Deployment failed",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/workloads/{name}": {
            "get": {
                "description": "Returns details for a specific workload by name",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "Get workload details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/agent.Workload"
                        }
                    },
                    "404": {
                        "description": "Workload not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Stops and removes a workload from the cluster",
                "tags": [
                    "workloads"
                ],
                "summary": "Delete a workload",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Workload deleted"
                    },
                    "404": {
                        "description": "Workload not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "description": "Updates workload configuration. Some fields require redeploy.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "Update a workload",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to update",
                        "name": "update",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/agent.Workload"
                        }
                    },
                    "404": {
                        "description": "Workload not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Mesh IP conflict",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Update failed",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/workloads/{name}/logs": {
            "get": {
                "description": "Returns container logs for a workload",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "Get workload logs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Container logs",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Workload not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/workloads/{name}/move": {
            "post": {
                "description": "Migrates a workload to a different node in the cluster",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "Move workload to another node",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Target node",
                        "name": "target",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/agent.MoveRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Workload moved"
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Workload or target not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/workloads/{name}/start": {
            "post": {
                "description": "Starts the containers for a workload that was previously stopped",
                "tags": [
                    "workloads"
                ],
                "summary": "Start a stopped workload",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Workload not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Start failed",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/workloads/{name}/stop": {
            "post": {
                "description": "Stops the containers for a workload without removing them",
                "tags": [
                    "workloads"
                ],
                "summary": "Stop a running workload",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workload name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Workload not found",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Stop failed",
                        "schema": {
                            "$ref": "#/definitions/agent.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "agent.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "workload not found"
                }
            }
        },
        "agent.HealthResponse": {
            "type": "object",
            "properties": {
                "cluster_status": {
                    "description": "Cluster health fields (when no filter or multiple nodes)",
                    "type": "string",
                    "example": "healthy"
                },
                "healthy_nodes": {
                    "type": "integer",
                    "example": 3
                },
                "id": {
                    "type": "string",
                    "example": "abc123def456"
                },
                "ip": {
                    "type": "string",
                    "example": "100.96.0.1"
                },
                "name": {
                    "type": "string",
                    "example": "node1"
                },
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/agent.NodeHealthStatus"
                    }
                },
                "public_ip": {
                    "type": "string",
                    "example": "203.0.113.1"
                },
                "status": {
                    "description": "Local health fields (when ?node=local or single node response)",
                    "type": "string",
                    "example": "healthy"
                },
                "system": {
                    "type": "object",
                    "additionalProperties": true
                },
                "timestamp": {
                    "type": "string",
                    "example": "2024-01-02T15:04:05Z"
                },
                "total_nodes": {
                    "type": "integer",
                    "example": 3
                },
                "total_workloads": {
                    "type": "integer",
                    "example": 10
                },
                "workloads_local": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "nginx:10.100.0.50:running"
                    ]
                },
                "workloads_total": {
                    "type": "integer",
                    "example": 5
                }
            }
        },
        "agent.JoinRequest": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string",
                    "example": "100.96.0.5"
                },
                "name": {
                    "type": "string"
                },
                "secret": {
                    "type": "string"
                }
            }
        },
        "agent.JoinResponse": {
            "type": "object",
            "properties": {
                "cf_token": {
                    "type": "string"
                },
                "peers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/agent.Peer"
                    }
                },
                "service_cidr": {
                    "type": "string",
                    "example": "10.100.0.0/16"
                },
                "tunnel_domain": {
                    "type": "string"
                },
                "warp_token": {
                    "type": "string"
                },
                "workloads": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/agent.Workload"
                    }
                }
            }
        },
        "agent.MoveRequest": {
            "type": "object",
            "properties": {
                "to": {
                    "type": "string",
                    "example": "node2"
                }
            }
        },
        "agent.NodeHealthStatus": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "healthy": {
                    "type": "boolean",
                    "example": true
                },
                "id": {
                    "type": "string",
                    "example": "abc123def456"
                },
                "ip": {
                    "type": "string",
                    "example": "100.96.0.1"
                },
                "name": {
                    "type": "string",
                    "example": "node1"
                },
                "public_ip": {
                    "type": "string",
                    "example": "203.0.113.1"
                },
                "status": {
                    "type": "string",
                    "example": "healthy"
                },
                "system": {
                    "type": "object",
                    "additionalProperties": true
                },
                "workloads": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "agent.NodeInfo": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "abc123def456"
                },
                "ip": {
                    "type": "string",
                    "example": "100.96.0.1"
                },
                "name": {
                    "type": "string",
                    "example": "node1"
                }
            }
        },
        "agent.Peer": {
            "type": "object",
            "properties": {
                "healthy": {
                    "type": "boolean"
                },
                "id": {
                    "description": "HWID",
                    "type": "string"
                },
                "ip": {
                    "description": "WARP IP (100.96.x.x) - primary address for node communication",
                    "type": "string"
                },
                "last_seen": {
                    "type": "string"
                },
                "name": {
                    "description": "Hostname",
                    "type": "string"
                }
            }
        },
        "agent.StatusResponse": {
            "type": "object",
            "properties": {
                "node": {
                    "$ref": "#/definitions/agent.NodeInfo"
                },
                "peers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/agent.Peer"
                    }
                },
                "service_cidr": {
                    "type": "string",
                    "example": "10.100.0.0/16"
                },
                "tunnel": {
                    "$ref": "#/definitions/agent.TunnelStatus"
                },
                "workloads": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/agent.Workload"
                    }
                }
            }
        },
        "agent.TunnelRequest": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhIjoiNjA2..."
                }
            }
        },
        "agent.TunnelStatus": {
            "type": "object",
            "properties": {
                "configured": {
                    "type": "boolean",
                    "example": true
                },
                "running": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "agent.Workload": {
            "type": "object",
            "properties": {
                "allowed_nodes": {
                    "description": "Node whitelist: empty/[\"*\"] = all, otherwise node names/IDs",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "autostart": {
                    "description": "Auto-start when Jetty starts up",
                    "type": "boolean"
                },
                "compose": {
                    "type": "string"
                },
                "ip": {
                    "description": "Service IP (routed via WARP)",
                    "type": "string"
                },
                "name": {
                    "description": "DNS hostname",
                    "type": "string"
                },
                "owner": {
                    "description": "Node HWID",
                    "type": "string"
                },
                "revive": {
                    "description": "Auto-failover to another node if owner dies",
                    "type": "boolean"
                },
                "version": {
                    "description": "Unix timestamp",
                    "type": "integer"
                }
            }
        },
        "agent.WorkloadRequest": {
            "type": "object",
            "properties": {
                "allowed_nodes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "node1",
                        "node2"
                    ]
                },
                "autostart": {
                    "type": "boolean",
                    "example": true
                },
                "compose": {
                    "type": "string",
                    "example": "services:\n  web:\n    image: nginx"
                },
                "ip": {
                    "type": "string",
                    "example": "10.100.0.50"
                },
                "name": {
                    "type": "string",
                    "example": "nginx"
                },
                "revive": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "API key for authentication (JETTY_SECRET)",
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    },
    "security": [
        {
            "ApiKeyAuth": []
        }
    ]
}